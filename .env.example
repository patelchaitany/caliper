# Copy to .env and fill in. Never commit the real file.

# --- Backend -----------------------------------------------------------------
# vertex    Claude on Google Cloud Vertex AI (auth via gcloud ADC)
# gemini    Gemini on Google Cloud Vertex AI (auth via gcloud ADC)
# anthropic Claude on the first-party API (auth via ANTHROPIC_API_KEY)
# replay    offline pattern matcher, no credentials, for tests and demos
CALIPER_BACKEND=vertex

# --- Vertex AI ---------------------------------------------------------------
CALIPER_GCP_PROJECT=your-project-id
# us-central1 for Claude partner models; `global` is the better default for
# Gemini, where model availability is widest.
CALIPER_GCP_REGION=us-central1

# --- Model -------------------------------------------------------------------
# claude-opus-5 for the vertex/anthropic backends, gemini-2.5-pro for gemini
CALIPER_MODEL=claude-opus-5
# low | medium | high | xhigh | max. Higher effort finds more, costs more.
CALIPER_EFFORT=high

# --- Storage -----------------------------------------------------------------
CALIPER_LEDGER=.caliper/ledger.db

# NOTE: no API key is needed for the vertex backend. Authentication is Google
# Application Default Credentials:
#     gcloud auth application-default login

# --- Output mode -------------------------------------------------------------
# auto        try structured outputs, fall back to forced tool use if an
#             organisation policy blocks the feature (the default)
# structured  require structured outputs; fail loudly if unavailable
# tool        always use forced tool use — set this on projects known to
#             restrict partner-model features, to skip the wasted first attempt
CALIPER_OUTPUT_MODE=auto
